{
  "name": "hello-web",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "hello-web/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "dependsOn": [
        {
          "projects": ["hello-world"],
          "target": "build:web"
        }
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/hello-web"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "dependsOn": [
        {
          "projects": ["hello-world"],
          "target": "build:web"
        }
      ],
      "options": {
        "buildTarget": "hello-web:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "hello-web:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "hello-web:build:production",
          "hmr": false
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "hello-web:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "hello-web:build:development"
        },
        "production": {
          "buildTarget": "hello-web:build:production"
        }
      }
    }
  }
}
