{
  "name": "studio",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "./studio/src",
  "targets": {
    "build": {
      "executor": "@nxrs/cargo:build",
      "options": {
        "release": false
      },
      "configurations": {
        "production": {
          "release": true
        }
      }
    },
    "build:web": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "wasm-pack build --out-dir ../dist/studio/ -- --features wasm",
          "node scripts/copy-assets.mjs"
        ],
        "cwd": "studio",
        "envFile": "studio/.env",
        "parallel": false
      }
    },
    "dev": {
      "executor": "@nxrs/cargo:run",
      "options": {
        "profile": "dev-custom",
        "bin": "studio-standalone"
      }
    },
    "test": {
      "executor": "@nxrs/cargo:test",
      "options": {}
    },
    "lint": {
      "executor": "@nxrs/cargo:clippy",
      "options": {
        "fix": false,
        "failOnWarnings": true,
        "noDeps": true
      }
    }
  },
  "tags": []
}
